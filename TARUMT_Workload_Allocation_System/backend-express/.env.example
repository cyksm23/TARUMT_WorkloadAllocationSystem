# ── Database (same PostgreSQL the schema/seeds target) ──────────────────────
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=1234
PGDATABASE=teaching_workload_db

# ── HTTP ────────────────────────────────────────────────────────────────────
PORT=8000

# ── Auth ────────────────────────────────────────────────────────────────────
# Must match the frontend's AUTH_SECRET so tokens stay interchangeable.
AUTH_SECRET=dev-secret-change-me
